{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imprentagg",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/pedido/*"]
  },
  "r2_buckets": [
    {
      "binding": "ORDER_FILES"
    }
  ],
  "vars": {
    "WHATSAPP_NUMBER": "5492665050096",
    "ORDER_RETENTION_DAYS": "7",
    "MAX_FILES_PER_ORDER": "6",
    "MAX_FILE_SIZE_MB": "20",
    "MAX_ORDER_SIZE_MB": "60"
  },
  "triggers": {
    "crons": ["17 5 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
